            float2 inputs:in.connect = </Cloth/blue_left_PBR/UV_Map.outputs:result>
            float2 inputs:scale = (0.725, 1.975)
            float2 inputs:translation = (0.17, 0.29)
            float2 outputs:result
        }
    }

    def Material "Blue_Bound_Edge" (
