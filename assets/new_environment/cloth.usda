#usda 1.0
(
    defaultPrim = "Cloth"
)

def Scope "Cloth"
{
    def Material "Drape_Green_Woven_PBR" (
        apiSchemas = ["ColorSpaceAPI"]
    )
    {
        uniform token colorSpace:name = "lin_rec709_scene"
        token outputs:surface.connect = </Cloth/Drape_Green_Woven_PBR/Principled_BSDF.outputs:surface>
        custom string userProperties:blender:data_name = "Drape_Green_Woven_PBR"

        def Shader "Principled_BSDF"
        {
            uniform token info:id = "UsdPreviewSurface"
            float inputs:clearcoat = 0
            float inputs:clearcoatRoughness = 0.03
            color3f inputs:diffuseColor.connect = </Cloth/Drape_Green_Woven_PBR/Image_Texture.outputs:rgb>
            float inputs:ior = 1.45
            float inputs:metallic = 0
            normal3f inputs:normal.connect = </Cloth/Drape_Green_Woven_PBR/Image_Texture_002.outputs:rgb>
            float inputs:opacity = 1
            float inputs:roughness.connect = </Cloth/Drape_Green_Woven_PBR/Image_Texture_001.outputs:r>
            float inputs:specular = 0.5
            token outputs:surface
        }

        def Shader "Image_Texture" (
            apiSchemas = ["ColorSpaceAPI"]
        )
        {
            uniform token colorSpace:name = "srgb_rec709_display"
            uniform token info:id = "UsdUVTexture"
            float4 inputs:bias = (0.063099496, 0.02668459, 0.03810752, 0)
            asset inputs:file = @textures/green_reference_rgb.png@
            float4 inputs:scale = (0.5, 0.5, 0.5, 1)
            token inputs:sourceColorSpace = "sRGB"
            float2 inputs:st.connect = </Cloth/Drape_Green_Woven_PBR/RGB_Texture_Scale.outputs:result>
            token inputs:wrapS = "repeat"
            token inputs:wrapT = "repeat"
            float3 outputs:rgb
        }

        def Shader "UV_Map"
        {
            uniform token info:id = "UsdPrimvarReader_float2"
            string inputs:varname = "st"
            float2 outputs:result
        }

        def Shader "Image_Texture_001" (
            apiSchemas = ["ColorSpaceAPI"]
        )
        {
            uniform token colorSpace:name = "data"
            uniform token info:id = "UsdUVTexture"
            asset inputs:file = @textures/drape_fabric_roughness.png@
            token inputs:sourceColorSpace = "raw"
            float2 inputs:st.connect = </Cloth/Drape_Green_Woven_PBR/UV_Map.outputs:result>
            token inputs:wrapS = "clamp"
            token inputs:wrapT = "clamp"
            float outputs:r
        }

        def Shader "Image_Texture_002" (
            apiSchemas = ["ColorSpaceAPI"]
        )
        {
            uniform token colorSpace:name = "data"
            uniform token info:id = "UsdUVTexture"
            float4 inputs:bias = (-0.45, -0.45, -1, -1)
            asset inputs:file = @textures/drape_creases_normal.png@
            float4 inputs:scale = (0.9, 0.9, 2, 2)
            token inputs:sourceColorSpace = "raw"
            float2 inputs:st.connect = </Cloth/Drape_Green_Woven_PBR/UV_Map.outputs:result>
            token inputs:wrapS = "clamp"
            token inputs:wrapT = "clamp"
            float3 outputs:rgb
        }

        def Shader "RGB_Texture_Scale"
        {
            uniform token info:id = "UsdTransform2d"
            float2 inputs:in.connect = </Cloth/Drape_Green_Woven_PBR/UV_Map.outputs:result>
            float2 inputs:scale = (8.3, 5.225)
            float2 inputs:translation = (0, 0)
            float2 outputs:result
        }
    }

